// MIRRORED FILE, NOT CANONICAL. The `lifeandsoul-bookings` repo owns this
// schema and its migration history (its pre-deploy command runs
// `prisma migrate deploy` against the shared production database on every
// deploy). This copy exists only so `prisma generate` here can produce a
// Prisma Client for this app's own queries. NEVER run `prisma migrate dev`
// or `prisma migrate deploy` from this repo — it has no migrations
// directory of its own on purpose, so doing so would fail loudly rather
// than silently create a second, conflicting migration history against the
// same database. When the schema changes, change it in
// `lifeandsoul-bookings` first, then copy the result here.
//
// Life & Soul bookings platform — core schema
//
// Key modelling decisions (see README for the full reasoning):
// - PaymentAccount is separate from Venue and is many-venues-to-one-account,
//   because DV8 has its own Dojo merchant account while Rumba (x2), Crazy
//   Moose, and Black Bear Lodge all settle through one shared account.
//   Revenue-per-venue reporting therefore has to come from Booking/Payment
//   rows tagged with venueId, never from the payment gateway.
// - BookingType carries minDurationMinutes/maxDurationMinutes so the
//   availability engine can never offer a slot that violates them (this is
//   what stops a bottomless brunch being booked 2pm-10pm).
// - Booking <-> Table is many-to-many via BookingTable to support combining
//   multiple tables onto one booking.
// - Payment is its own ledger table, not just fields on Booking, so a
//   booking can have a deposit payment now and a balance payment later,
//   and so refunds/re-captures have somewhere to live.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Payment accounts (Dojo merchant accounts)
// ---------------------------------------------------------------------------

enum PaymentProviderKind {
  DOJO
}

/// One row per real-world Dojo merchant account. `code` is used to look up
/// the matching DOJO_API_KEY_<code> / DOJO_WEBHOOK_SECRET_<code> env vars —
/// see lib/payments/get-provider.ts. Nothing secret is ever stored in the DB.
model PaymentAccount {
  id        String              @id @default(cuid())
  name      String // e.g. "DV8", "Life & Soul Group"
  code      String              @unique // e.g. "DV8", "LIFE_AND_SOUL" — matches env var suffix
  provider  PaymentProviderKind @default(DOJO)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  venues   Venue[]
  payments Payment[]
}

// ---------------------------------------------------------------------------
// Venues
// ---------------------------------------------------------------------------

model Venue {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // used in widget embeds and API routes, e.g. "dv8"
  timezone  String   @default("Europe/London")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Real-world contact details — also what satisfies Dojo's "contact
  // details" website checklist item per venue, and what booking
  // confirmation emails will show as the "from" venue in Phase 2.
  address String?
  phone   String?
  email   String?

  // Nullable on purpose: a venue can exist (and take non-deposit bookings
  // or enquiries) before its Dojo merchant account assignment is settled.
  // Arriba is the current example — not part of either named Dojo account
  // yet, see seed.ts.
  paymentAccountId String?
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id])

  /// Short code used in customer-facing booking references, e.g. "BB" for
  /// Black Bear Lodge, "DV8" for DV8 — see formatBookingRef() in
  /// lib/bookings/booking-reference.ts. Nullable: a venue can exist before
  /// its code is assigned, in which case its bookings just don't get a
  /// reference (never blocks booking creation) until this is set.
  bookingCode String? @unique

  /// Running count of bookings ever made at this venue, incremented once per
  /// booking (never reset) to generate the trailing digits of bookingRef —
  /// see formatBookingRef(). Not a count of *current* bookings — it only
  /// goes up, including for cancelled ones, so two bookings never share a
  /// reference even after one is cancelled.
  bookingRefCounter Int @default(0)

  /// High-water mark for the inbound-email poll (bookings-view's
  /// /api/cron/poll-inbox) — only messages received after this are fetched
  /// from the venue's mailbox on the next run, so the same reply is never
  /// turned into two Message rows. Null until the poll has run at least
  /// once for this venue (or until email is configured at all — see
  /// lib/email/graph-client.ts's doc comment for the whole email design).
  lastInboxSyncAt DateTime?

  bookingTypes           BookingType[]
  tables                 Table[]
  areas                  Area[]
  openingHours           OpeningHours[]
  openingHoursExceptions OpeningHoursException[]
  openingHoursBlocks     OpeningHoursBlock[]
  bookings               Booking[]
  enquiries              Enquiry[]
  menus                  Menu[]
  staff                  StaffUser[]
}

// ---------------------------------------------------------------------------
// Opening hours
// ---------------------------------------------------------------------------

/// Recurring weekly opening hours. One row per (venue, dayOfWeek); absence of
/// a row for a given day means closed that day by default.
model OpeningHours {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  /// 0 = Sunday ... 6 = Saturday (matches JS Date#getDay())
  dayOfWeek Int

  /// Stored as "HH:mm" 24hr strings, interpreted in the venue's timezone.
  opensAt  String
  closesAt String

  @@unique([venueId, dayOfWeek])
}

/// One-off overrides for a specific date: extra Christmas/NYE hours, a
/// private hire closing the venue to the public, a bank holiday, etc.
/// Where a row exists for a date it entirely replaces OpeningHours for that
/// date.
model OpeningHoursException {
  id       String   @id @default(cuid())
  venueId  String
  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  isClosed Boolean  @default(false)

  /// Only used when isClosed is false.
  opensAt  String?
  closesAt String?
  note     String?

  @@unique([venueId, date])
}

/// A carve-out within an otherwise-open day — a private event from 14:00 to
/// 18:00 on a day the venue is normally open 12:00-22:00, say. Unlike
/// OpeningHoursException (which entirely replaces the day's hours),
/// multiple blocks can apply to one date, and whatever the day's hours are
/// (weekly or exception) still apply outside the blocked range(s). The
/// availability engine subtracts these ranges from whatever window it
/// resolved for the date — see subtractBlocks() in opening-window.ts.
model OpeningHoursBlock {
  id       String   @id @default(cuid())
  venueId  String
  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  startsAt String
  endsAt   String
  note     String?

  createdAt DateTime @default(now())

  @@index([venueId, date])
}

// ---------------------------------------------------------------------------
// Booking types
// ---------------------------------------------------------------------------

enum DepositType {
  NONE
  FIXED
  PER_HEAD
}

/// e.g. "Standard Dining", "Bottomless Brunch", "Private Hire". Drives the
/// booking flow: customers pick a BookingType before date/guests/time, and
/// the type's own duration bounds constrain what times/durations can be
/// offered.
model BookingType {
  id          String  @id @default(cuid())
  venueId     String
  venue       Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  minPartySize Int @default(1)
  maxPartySize Int @default(20)

  /// A booking of this type can never be shorter than minDurationMinutes or
  /// longer than maxDurationMinutes. This is the rule that stops a
  /// bottomless brunch being booked 2pm-10pm.
  minDurationMinutes  Int
  maxDurationMinutes  Int
  /// Granularity offered to the customer between min and max, e.g. 30 min
  /// steps. Must evenly divide (maxDurationMinutes - minDurationMinutes)
  /// in the common case, but the availability engine doesn't require that.
  durationStepMinutes Int @default(30)

  /// Granularity of start times offered within opening hours, e.g. every 15
  /// or 30 minutes.
  startTimeStepMinutes Int @default(15)

  depositType   DepositType @default(NONE)
  /// Pence. Meaning depends on depositType: a flat amount for FIXED, an
  /// amount per guest for PER_HEAD.
  depositAmount Int?

  requiresPreOrder Boolean @default(false)

  /// Above this party size, a booking of this type is created as ENQUIRY
  /// instead of auto-confirming, for staff to review and confirm manually —
  /// e.g. a table for 10 books instantly, a table for 20 needs a human.
  /// Null means always auto-confirm (no enquiry threshold). An enquiry
  /// booking skips table auto-assignment (see generateAvailableSlots'
  /// enquiry-mode branch) since staff sort out the table when they confirm;
  /// this is also the fix for the pre-existing "party too big for any
  /// single table gets zero slots" dead end noted in generate-slots.ts —
  /// once a booking type has a threshold, an over-threshold party is no
  /// longer required to fit an actual table just to get an available slot.
  enquiryThresholdPartySize Int?

  /// Restricts which tables this booking type's auto-assignment is allowed
  /// to use — e.g. Bottomless Brunch might be restricted to tables 6-10
  /// while a standard food table booking is left unrestricted. Empty means
  /// "every active table at the venue" (the pre-existing default). Always
  /// stored as a table list even when the admin picks it via an area (the
  /// admin UI's "restrict by area" control just checks every table in that
  /// area at save time) — see assignTables in generate-slots.ts.
  allowedTables Table[] @relation("BookingTypeAllowedTables")

  /// Hex colour (e.g. "#7c3aed") shown as a banner/strip on this booking
  /// type's blocks in the staff table diary, so "Bottomless Brunch" and
  /// "Standard Dining" are visually distinguishable at a glance. Nullable —
  /// admin-set, not required; the diary falls back to a deterministic
  /// colour picked from a fixed palette (hashed on id) when this is unset,
  /// see colourForBookingType() in bookings-view's diary-grid.tsx.
  color String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  menus    Menu[]

  @@unique([venueId, slug])
}

// ---------------------------------------------------------------------------
// Tables
// ---------------------------------------------------------------------------

/// A named grouping of tables sharing a location — "Downstairs", "Upstairs",
/// "Terrace". `priority` controls fill order for auto-assignment: lower
/// fills first, so the algorithm exhausts one area's capacity before
/// spilling a booking into the next — see assignTables in generate-slots.ts.
model Area {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name    String
  /// Lower number = filled first. Admin-orderable list, not necessarily
  /// contiguous or unique — ties break on Table.sortOrder.
  priority Int   @default(0)

  tables Table[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, name])
}

model Table {
  id        String  @id @default(cuid())
  venueId   String
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  label     String // e.g. "T12", "Booth 3"
  minCovers Int     @default(1)
  maxCovers Int
  active    Boolean @default(true)

  /// Nullable — a table not yet assigned to an area is still fully
  /// bookable, just treated as the lowest-priority group by assignTables.
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id])

  /// Display order in the staff diary's table-timeline view (bookings-view's
  /// /staff/diary) — lets "T1, T2, ... T13, Booth 1, Booth 2" stay in that
  /// order rather than sorting "T10" before "T2" as strings. Also the
  /// tie-breaker for auto-assignment ordering within an area.
  sortOrder Int @default(0)

  // Deliberately no x/y layout coordinates yet — Phase 1 assigns bookings to
  // tables from a list, the visual drag-drop floor plan is Phase 3. Adding
  // layout fields later is a non-breaking migration.

  bookingTables          BookingTable[]
  allowedForBookingTypes BookingType[]  @relation("BookingTypeAllowedTables")

  /// Symmetric adjacency — physically neighbouring tables that can be
  /// combined onto one booking together, and that the auto-assignment
  /// spacing rule tries to avoid double-booking side by side. Split into two
  /// relations because Prisma models a self-relation as directed; TableLink
  /// rows themselves are meant as unordered pairs (see linkedTableIds() in
  /// generate-slots.ts, which reads both sides).
  tableLinksAsA TableLink[] @relation("TableLinkA")
  tableLinksAsB TableLink[] @relation("TableLinkB")

  @@unique([venueId, label])
}

/// One physical adjacency between two tables at the same venue — admin-set,
/// not inferred from sortOrder, because display order and floor layout
/// don't always match (Booth 3 might sit next to T1, not T2). Used two ways:
/// combining tables to seat a party bigger than any single table, and
/// preferring to leave a gap between two *different* parties' tables when
/// picking among several tables that would each fit alone.
model TableLink {
  id       String @id @default(cuid())
  tableAId String
  tableA   Table  @relation("TableLinkA", fields: [tableAId], references: [id], onDelete: Cascade)
  tableBId String
  tableB   Table  @relation("TableLinkB", fields: [tableBId], references: [id], onDelete: Cascade)

  @@unique([tableAId, tableBId])
}

// ---------------------------------------------------------------------------
// Bookings
// ---------------------------------------------------------------------------

enum BookingStatus {
  ENQUIRY
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  WIDGET
  ADMIN
  PHONE
}

model Booking {
  id            String      @id @default(cuid())
  venueId       String
  venue         Venue       @relation(fields: [venueId], references: [id])
  bookingTypeId String
  bookingType   BookingType @relation(fields: [bookingTypeId], references: [id])

  date      DateTime @db.Date
  startTime String // "HH:mm", venue-local
  endTime   String // "HH:mm", venue-local — derived from chosen duration

  partySize Int
  status    BookingStatus @default(ENQUIRY)
  source    BookingSource @default(WIDGET)

  /// Customer-facing confirmation number, e.g. "BB-030901" (Black Bear
  /// Lodge, 3rd Sept, the venue's 1st-ever booking) — see
  /// formatBookingRef() in lib/bookings/booking-reference.ts. Null when the
  /// venue has no bookingCode assigned yet (never blocks booking creation)
  /// or for a booking made before this feature existed — never backfilled,
  /// so its absence on an old row isn't a bug.
  bookingRef String? @unique

  customerName  String
  /// Nullable — the customer widget still always requires it (validated at
  /// the API layer, not the DB), but a same-day manual "Add booking" in
  /// bookings-view needs neither email nor phone (see that flow's actions.ts
  /// doc comment), so at least one of the two, not both, is what the DB
  /// actually enforces nothing about. Anything that dedupes bookings by
  /// customer (get-customers.ts, marketing-export) has to account for this
  /// being null.
  customerEmail String?
  customerPhone String?
  notes         String?

  /// Optional — added to the customer booking form specifically to power
  /// the admin Customers page's "birthday" filter (a "who's got a birthday
  /// this month" marketing list). Nothing backfills this for bookings made
  /// before the field existed; its absence on an old row isn't a bug. Date
  /// only (no year requirement in the UI, but stored as a full date — the
  /// birthday filter reads month+day off it and ignores the year).
  customerDateOfBirth DateTime? @db.Date

  /// Customer opted in to marketing communications at booking time — shown
  /// as a checkbox on the customer booking form, exported/filtered on in
  /// bookings-view's admin customer list. Never inferred, only ever what the
  /// customer actually ticked.
  marketingOptIn Boolean @default(false)

  /// Free-text name of whoever took this booking over the phone/in person —
  /// set only by the manual "Add booking"/"Add enquiry" flows in
  /// bookings-view (source PHONE), never by the customer widget (WIDGET) or
  /// left blank for those. Free text rather than a StaffUser relation
  /// because every venue shares one login (see StaffUser doc comment) — an
  /// individual name typed here is the only record of who actually took it.
  takenByStaffName String?

  bookingTables BookingTable[]
  payments      Payment[]
  preOrder      PreOrder?
  messages      Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, date])
}

/// Join table so a booking can span multiple combined tables.
model BookingTable {
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tableId   String
  table     Table   @relation(fields: [tableId], references: [id])

  @@id([bookingId, tableId])
}

// ---------------------------------------------------------------------------
// Enquiries (non-bookable requests: large parties, private hire, etc.)
// ---------------------------------------------------------------------------

enum EnquiryStatus {
  NEW
  RESPONDED
  CONVERTED
  CLOSED
}

model Enquiry {
  id        String        @id @default(cuid())
  venueId   String
  venue     Venue         @relation(fields: [venueId], references: [id])
  name      String
  email     String
  phone     String?
  message   String
  eventDate DateTime?     @db.Date
  partySize Int?
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// Menus / pre-orders
// ---------------------------------------------------------------------------

model Menu {
  id            String       @id @default(cuid())
  venueId       String
  venue         Venue        @relation(fields: [venueId], references: [id])
  bookingTypeId String?
  bookingType   BookingType? @relation(fields: [bookingTypeId], references: [id])
  name          String
  description   String?
  active        Boolean      @default(true)

  items     MenuItem[]
  preOrders PreOrder[]
}

model MenuItem {
  id           String   @id @default(cuid())
  menuId       String
  menu         Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  priceInPence Int
  dietaryTags  String[] @default([])
  active       Boolean  @default(true)

  preOrderItems PreOrderItem[]
}

model PreOrder {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id])
  createdAt DateTime @default(now())

  items PreOrderItem[]
}

model PreOrderItem {
  id         String   @id @default(cuid())
  preOrderId String
  preOrder   PreOrder @relation(fields: [preOrderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  guestLabel String? // e.g. "Guest 2", optional per-guest attribution
  notes      String?
}

// ---------------------------------------------------------------------------
// Payments ledger
// ---------------------------------------------------------------------------

enum PaymentPurpose {
  DEPOSIT
  BALANCE
  FULL
}

enum PaymentCaptureMode {
  AUTO
  MANUAL
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  REFUNDED
  REVERSED
  CANCELLED
  FAILED
}

/// A record of one Dojo payment intent against one booking. Kept separate
/// from Booking so a booking can have a deposit now and a balance payment
/// later, and so refunds have a natural home.
model Payment {
  id               String         @id @default(cuid())
  bookingId        String
  booking          Booking        @relation(fields: [bookingId], references: [id])
  paymentAccountId String
  paymentAccount   PaymentAccount @relation(fields: [paymentAccountId], references: [id])

  purpose     PaymentPurpose
  captureMode PaymentCaptureMode @default(AUTO)
  status      PaymentStatus      @default(CREATED)

  amountInPence Int
  currency      String @default("GBP")

  /// Dojo's payment intent id, so webhooks can be reconciled back to this row.
  providerPaymentIntentId String? @unique

  createdAt  DateTime  @default(now())
  capturedAt DateTime?
  refundedAt DateTime?

  @@index([bookingId])
}

// ---------------------------------------------------------------------------
// Staff (per-venue admin users)
//
// This table is read/written by the separate `bookings-view` app (staff
// dashboard + admin, kept off this app's domain on purpose so a customer
// booking widget embedded on venue websites never shares an origin with a
// staff login). This schema is THE canonical one for the shared database —
// only this repo's pre-deploy command runs `prisma migrate deploy`.
// bookings-view keeps its own copy of this file (for its own generated
// Prisma client) but must never run its own migration against this DB.
// Changing this model without mirroring the change there will drift the
// two apps out of sync with each other.
// ---------------------------------------------------------------------------

enum StaffRole {
  OWNER
  MANAGER
  STAFF
}

model StaffUser {
  id      String    @id @default(cuid())
  /// Null for OWNER/MANAGER — those roles are venue-independent and see/
  /// manage every venue from one login, not scoped to any single one. A
  /// STAFF login is always tied to exactly one venue (its diary is the only
  /// thing a STAFF session can see), so venueId is required in practice for
  /// that role even though the column itself is nullable — enforced in
  /// application code (bookings-view's staff-create action), not a DB
  /// constraint, since this table has no writers outside that one app.
  venueId String?
  venue   Venue?    @relation(fields: [venueId], references: [id])
  name    String
  email   String    @unique
  role    StaffRole @default(STAFF)

  /// bcrypt hash, never the plaintext password. Login is email+password,
  /// handled entirely in the bookings-view app — no OAuth/SSO in scope yet.
  passwordHash String

  /// Lets a login be disabled (someone leaves, a password needs rotating)
  /// without deleting the row and losing whatever ends up referencing it.
  active Boolean @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  sentMessages Message[]
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

/// A record of one email to/from a customer about a specific booking —
/// the history shown on the booking details page in bookings-view. Sending
/// isn't wired up yet (needs an email provider decision — see that app's
/// README), so nothing writes OUTBOUND rows until that's connected; the
/// model exists now so the booking details page has somewhere real to read
/// from rather than a placeholder.
model Message {
  id          String           @id @default(cuid())
  bookingId   String
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  direction   MessageDirection
  subject     String?
  body        String
  /// Who sent an OUTBOUND message. Null for INBOUND (the customer has no
  /// StaffUser row) and null for OUTBOUND messages sent by an automated
  /// flow (e.g. a future booking-confirmation email) rather than a person.
  staffUserId String?
  staffUser   StaffUser?       @relation(fields: [staffUserId], references: [id])

  /// Drives the Messages tab (bookings-view's /staff/[venueSlug]/messages,
  /// "bookings with unread messages"). Only meaningful for INBOUND — an
  /// OUTBOUND row defaults to true (whoever sent it has obviously "read"
  /// it) so it never shows up as needing attention; the inbound-poll job
  /// explicitly sets false when it creates a row from a customer reply, and
  /// staff mark it back to true from the booking details page.
  read Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([bookingId])
}
