# Same Postgres database as the lifeandsoul-bookings app — this app never
# runs migrations against it (see prisma/schema.prisma's header comment).
DATABASE_URL="postgresql://user:password@localhost:5432/lifeandsoul_bookings?schema=public"

# Signs staff login session cookies (see src/lib/auth/session.ts).
# Generate with: openssl rand -base64 32
# This is a separate secret from anything in lifeandsoul-bookings.
AUTH_SECRET=""
